generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  WORKER
  CREATOR
  ADMIN
}

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
}

enum WalletStatus {
  PENDING
  VERIFIED
  INVALID
}

enum QuestCategory {
  PRODUCT_TESTING
  SOCIAL_CAMPAIGN
  COMMUNITY_ENGAGEMENT
  REFERRAL
  CONTENT
  FEEDBACK
  BUG_BOUNTY
  OTHER
}

enum QuestProofType {
  TEXT
  LINK
  SCREENSHOT
  TRANSACTION_HASH
  REFERRAL_EVENT
  WALLET_INTERACTION
  UPLOADED_MEDIA
}

enum QuestStatus {
  DRAFT
  PUBLISHED
  CLOSED
  ARCHIVED
}

// Time-series event log powering the creator "Manage Quests" analytics view.
// VIEW = a public quest page was opened; FILL = a slot was claimed/completed.
enum QuestEventType {
  VIEW
  FILL
}

// Outcome of a worker's quest submission. Creators review PENDING proofs before payout.
enum SubmissionStatus {
  ACCEPTED
  PENDING
  REJECTED
}

// Architecture decision outcomes from the hybrid verification pipeline (M3).
enum VerificationOutcome {
  AUTO_APPROVE
  LIGHT_REVIEW
  MANUAL_REVIEW
  REJECT
}

model User {
  id               String     @id @default(uuid()) @db.Uuid
  telegramId       String     @unique @map("telegram_id")
  telegramUsername String?    @map("telegram_username")
  displayName      String?    @map("display_name")
  role             UserRole   @default(WORKER)
  status           UserStatus @default(PENDING)
  reputationScore  Int        @default(0) @map("reputation_score")
  // Optional secure-action password (scrypt "salt:hash"), required to confirm withdrawals.
  securityPasswordHash String? @map("security_password_hash")
  // Preferred bot language (ISO code); defaults to English.
  languageCode     String     @default("en") @map("language_code")
  // Referral graph: who invited this user (set on first successful referral proof or invite link).
  referredById     String?    @map("referred_by_id") @db.Uuid
  // Last time reputation was decayed for inactivity (idempotent daily decay).
  reputationDecayedAt DateTime? @map("reputation_decayed_at")
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  referredBy        User?              @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals         User[]             @relation("UserReferrals")
  walletProfiles    WalletProfile[]
  walletAudits      WalletAddressAudit[]
  quests            Quest[]
  submissions       QuestSubmission[]
  moderationEvents  ModerationEvent[]
  referralsMade     ReferralEdge[]     @relation("ReferrerEdges")
  referralsReceived ReferralEdge[]     @relation("ReferredEdges")
  reputationEvents  ReputationEvent[]

  @@index([referredById])
  @@map("users")
}

// Auditable reputation history: accepts, rejects, fraud flags, and decay.
model ReputationEvent {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  kind      String   @map("kind") @db.VarChar(32)
  delta     Int      @default(0)
  category  String?  @db.VarChar(64)
  detail    Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([kind])
  @@map("reputation_events")
}

// Explicit referrer → referred edges for farming-cluster analysis.
model ReferralEdge {
  id         String   @id @default(uuid()) @db.Uuid
  referrerId String   @map("referrer_id") @db.Uuid
  referredId String   @map("referred_id") @db.Uuid
  questId    String?  @map("quest_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at")

  referrer User @relation("ReferrerEdges", fields: [referrerId], references: [id], onDelete: Cascade)
  referred User @relation("ReferredEdges", fields: [referredId], references: [id], onDelete: Cascade)

  @@unique([referrerId, referredId])
  @@index([referredId])
  @@map("referral_edges")
}

model WalletProfile {
  id           String       @id @default(uuid()) @db.Uuid
  userId       String       @map("user_id") @db.Uuid
  nimiqAddress String       @unique @map("nimiq_address")
  status       WalletStatus @default(PENDING)
  isPrimary    Boolean      @default(false) @map("is_primary")
  // Custodial wallets: the private key, encrypted at rest (AES-256-GCM). Null for
  // externally-linked (non-custodial) wallets. Never leaves the server.
  keyCiphertext String?     @map("key_ciphertext") @db.Text
  linkedAt     DateTime     @default(now()) @map("linked_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One wallet per user (custodial model). Also serialises concurrent wallet creation:
  // a racing insert hits this constraint instead of creating a duplicate.
  @@unique([userId])
  @@map("wallet_profiles")
}

model WalletAddressAudit {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  oldAddress  String?  @map("old_address")
  newAddress  String?  @map("new_address")
  changedAt   DateTime @default(now()) @map("changed_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("wallet_address_audits")
}

model Quest {
  id                 String         @id @default(uuid()) @db.Uuid
  creatorId          String         @map("creator_id") @db.Uuid
  title              String         @db.VarChar(100)
  category           QuestCategory
  description        String         @db.Text
  rewardAmount       Decimal        @map("reward_amount") @db.Decimal(18, 8)
  totalSlots         Int            @map("total_slots")
  filledSlots        Int            @default(0) @map("filled_slots")
  proofType          QuestProofType @map("proof_type")
  proofInstructions  String         @map("proof_instructions") @db.Text
  // Optional sample-evidence image the creator uploads (a small compressed JPEG data URL)
  // to show workers an example of the proof they should submit.
  sampleEvidence     String?        @map("sample_evidence") @db.Text
  // Optional per-quest verification overrides (target address, min amount, hashtags, etc.).
  verificationConfig Json?          @map("verification_config")
  status             QuestStatus    @default(DRAFT)
  // Optional schedule: when set in the future, the quest is funded at publish but only goes
  // live (accepts submissions) once this time passes. Null = live immediately on publish.
  startAt            DateTime?      @map("start_at")
  // Promoted ("premium ad") — creator paid to feature it; sorts first + highlighted.
  promoted           Boolean        @default(false)
  createdAt          DateTime       @default(now()) @map("created_at")
  publishedAt        DateTime?      @map("published_at")
  // Analytics — incremented when a worker views the quest (worker discovery, M2).
  viewCount          Int            @default(0) @map("view_count")
  // Per-quest escrow wallet: the creator funds this address with the total reward pool.
  // The private key is stored encrypted (AES-256-GCM); we only ever expose the address.
  escrowAddress       String?  @map("escrow_address")
  escrowKeyCiphertext String?  @map("escrow_key_ciphertext") @db.Text
  fundedAt            DateTime? @map("funded_at")

  creator     User              @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  events      QuestEvent[]
  submissions QuestSubmission[]

  @@index([creatorId])
  @@index([status])
  @@map("quests")
}

// Append-only analytics events. One row per view/fill so the studio can chart
// activity over time (aggregated per day server-side).
model QuestEvent {
  id        String         @id @default(uuid()) @db.Uuid
  questId   String         @map("quest_id") @db.Uuid
  type      QuestEventType
  createdAt DateTime       @default(now()) @map("created_at")

  quest Quest @relation(fields: [questId], references: [id], onDelete: Cascade)

  @@index([questId, type, createdAt])
  @@map("quest_events")
}

// A worker's attempt at a quest. One per (quest, user) — the unique constraint also
// prevents a double-submit race. `proof` holds the worker's response (text/link/hash/etc).
model QuestSubmission {
  id        String           @id @default(uuid()) @db.Uuid
  questId   String           @map("quest_id") @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  proof     String           @db.Text
  status    SubmissionStatus @default(PENDING)
  // Hybrid verification pipeline (M3) — set after rule + AI decision.
  verificationOutcome VerificationOutcome? @map("verification_outcome")
  confidenceScore     Float?               @map("confidence_score")
  verificationSignals Json?                @map("verification_signals")
  verifiedAt          DateTime?            @map("verified_at")
  // On-chain payout of the reward to the worker (paid when the creator accepts). Null when
  // payments aren't configured (dev) or a payout hasn't settled yet.
  payoutTxHash String?       @map("payout_tx_hash")
  paidAt       DateTime?     @map("paid_at")
  // Indexed content fingerprint (image pHash / text hash) for cross-account cluster detection.
  contentHash       String? @map("content_hash") @db.VarChar(128)
  // Client device fingerprint + hashed IP for Sybil / farming signals.
  clientFingerprint String? @map("client_fingerprint") @db.VarChar(128)
  ipHash            String? @map("ip_hash") @db.VarChar(64)
  // CREATOR = Studio light review; PLATFORM = admin moderator queue (MANUAL_REVIEW).
  moderationQueue   String? @map("moderation_queue") @db.VarChar(16)
  createdAt DateTime         @default(now()) @map("created_at")

  quest            Quest             @relation(fields: [questId], references: [id], onDelete: Cascade)
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  moderationEvents ModerationEvent[]

  @@unique([questId, userId])
  @@index([questId])
  @@index([contentHash])
  @@index([ipHash])
  @@index([clientFingerprint])
  @@index([moderationQueue, status])
  @@map("quest_submissions")
}

// Trust and review history for the verification / moderation pipeline (M3).
model ModerationEvent {
  id           String   @id @default(uuid()) @db.Uuid
  submissionId String   @map("submission_id") @db.Uuid
  userId       String?  @map("user_id") @db.Uuid
  flagType     String   @map("flag_type") @db.VarChar(64)
  resolution   String   @map("resolution") @db.VarChar(64)
  detail       Json?
  createdAt    DateTime @default(now()) @map("created_at")

  submission QuestSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  user       User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([submissionId])
  @@index([userId])
  @@map("moderation_events")
}
