# App
NODE_ENV=development
APP_ENV=development
PORT=3001
LOG_LEVEL=info

# Telegram (Day 3+)
# Leave WEBHOOK_URL empty to use long polling locally.
BOT_TOKEN=
WEBHOOK_URL=
WEBHOOK_SECRET=
BOT_WEBHOOK_PORT=3002

# Supabase — Postgres + Storage (optional for local dev; Docker Postgres below is enough for M1)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Local Postgres via Docker Compose (default for development)
DATABASE_URL=postgresql://nimiqearn:nimiqearn@localhost:5432/nimiqearn

# Redis — bot sessions + rate limits
REDIS_URL=redis://localhost:6379

# Bot → API (Day 3+)
API_URL=http://localhost:3001
# Optional shared secret. When set on BOTH bot and API, all /api routes require it
# (sent by the bot as the x-internal-key header). Leave empty for local dev.
API_SHARED_SECRET=
# Public URL of the web app — used by the bot to build the wallet signing link.
WEB_PUBLIC_URL=http://localhost:3000

# Nimiq
NIMIQ_NETWORK=testnet
NIMIQ_RPC_URL=

# Web (apps/web)
NEXT_PUBLIC_BOT_URL=https://t.me/YourBot
NEXT_PUBLIC_API_URL=http://localhost:3001
# Nimiq Hub used by the wallet signing page. Use https://hub.nimiq-testnet.com for testnet.
NEXT_PUBLIC_HUB_URL=https://hub.nimiq.com
# Override only if you want to pin/host the Hub SDK yourself.
NEXT_PUBLIC_HUB_SDK_URL=https://esm.sh/@nimiq/hub-api@1
# Public contact email — when set, a Contact link appears in the footer and About page.
NEXT_PUBLIC_CONTACT_EMAIL=

# Admin read-only API (M1). When set, /api/admin/* requires the x-admin-key header.
ADMIN_API_KEY=

# Error monitoring (Sentry). Leave empty to disable — the API, bot, and web all
# run normally with no Sentry account. Set the DSN(s) from your Sentry project to
# start capturing errors. NEXT_PUBLIC_SENTRY_DSN is exposed to the browser (web app).
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional: enables source-map upload during `next build` for readable web stack traces.
SENTRY_AUTH_TOKEN=

# AI Verifier (M3)
VERIFIER_URL=
OPENAI_API_KEY=
